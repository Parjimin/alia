<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gallery_pale">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp">

        <ImageButton
            android:id="@+id/gallery_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start"
            android:background="@drawable/gallery_back_background"
            android:contentDescription="@string/gallery_back_description"
            android:padding="14dp"
            android:src="@drawable/gallery_back_icon" />

        <TextView
            android:id="@+id/gallery_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:textColor="@color/deep_navy"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/gallery_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxWidth="300dp"
            android:textColor="@color/deep_navy"
            android:textSize="13sp" />

        <com.littleblueworld.alia.gallery.GallerySquareLayout
            android:layout_width="match_parent"
            android:layout_height="330dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/gallery_stage_background"
            android:padding="13dp">

            <com.littleblueworld.alia.gallery.GalleryPagerView
                android:id="@+id/gallery_pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="yes" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/photo_frame" />
        </com.littleblueworld.alia.gallery.GallerySquareLayout>

        <TextView
            android:id="@+id/gallery_index"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:textColor="@color/deep_ocean"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/gallery_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingExtra="3dp"
            android:maxWidth="304dp"
            android:minHeight="42dp"
            android:textColor="@color/deep_navy"
            android:textSize="15sp" />

    </LinearLayout>

</FrameLayout>
