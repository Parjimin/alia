<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cafe_sky">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/cafe_hero"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/cafe" />

        <LinearLayout
            android:id="@+id/cafe_forecast_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/cafe_forecast_background"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="18dp">

            <TextView
                android:id="@+id/cafe_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.05"
                android:textColor="@color/soft_purple"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cafe_forecast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:includeFontPadding="false"
                android:lineSpacingExtra="1dp"
                android:textColor="@color/deep_navy"
                android:textSize="13sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/cafe_response"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:accessibilityLiveRegion="polite"
            android:fontFamily="monospace"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/deep_navy"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/cafe_beverages"
            android:layout_width="match_parent"
            android:layout_height="116dp"
            android:baselineAligned="false"
            android:gravity="center"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/tea_choice"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/cafe_choice_background"
                android:clickable="true"
                android:contentDescription="@string/cafe_tea_description"
                android:focusable="true"
                android:padding="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/teacup" />

            </FrameLayout>

            <FrameLayout
                android:id="@+id/coffee_choice"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/cafe_choice_background"
                android:clickable="true"
                android:contentDescription="@string/cafe_coffee_description"
                android:focusable="true"
                android:padding="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/coffee" />

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

    <ImageButton
        android:id="@+id/cafe_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/gallery_back_background"
        android:contentDescription="@string/cafe_back_description"
        android:padding="14dp"
        android:src="@drawable/gallery_back_icon" />

</FrameLayout>
