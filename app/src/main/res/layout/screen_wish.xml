<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/wish_day"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/world_day" />

    <ImageView
        android:id="@+id/wish_dusk"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/world_dusk" />

    <com.littleblueworld.alia.wish.WishEffectsView
        android:id="@+id/wish_effects"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/wish_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <FrameLayout
            android:id="@+id/wish_hero_stage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="112dp">

            <TextView
                android:id="@+id/wish_intro_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:accessibilityLiveRegion="polite"
                android:fontFamily="monospace"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/cream_white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:visibility="invisible" />

            <ImageView
                android:id="@+id/wish_star_hero"
                android:layout_width="208dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:clickable="true"
                android:contentDescription="@string/wish_star_description"
                android:focusable="true"
                android:scaleType="fitCenter"
                android:src="@drawable/wish_star"
                android:visibility="invisible" />

            <ImageView
                android:id="@+id/wish_capsule"
                android:layout_width="164dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/wish_capsule"
                android:visibility="gone" />

        </FrameLayout>

        <LinearLayout
            android:id="@+id/wish_input_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/wish_panel_background"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="16dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/wish_prompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/wish_input_label"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:labelFor="@id/wish_input"
                android:textColor="@color/deep_navy"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/wish_input"
                android:layout_width="match_parent"
                android:layout_height="116dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/wish_input_background"
                android:fontFamily="sans-serif"
                android:gravity="top|start"
                android:importantForAutofill="noExcludeDescendants"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="500"
                android:maxLines="6"
                android:saveEnabled="false"
                android:scrollbars="vertical"
                android:textColor="@color/deep_navy"
                android:textColorHint="@color/soft_purple"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/wish_counter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="monospace"
                android:gravity="end"
                android:includeFontPadding="false"
                android:textColor="@color/soft_purple"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/wish_error"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:accessibilityLiveRegion="assertive"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/soft_purple"
                android:textSize="13sp"
                android:visibility="invisible" />

            <com.littleblueworld.alia.wish.PixelHoldButton
                android:id="@+id/wish_hold"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/wish_hold_background"
                android:contentDescription="@string/wish_hold_description"
                android:fontFamily="monospace"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:textColor="@color/deep_navy"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/wish_destination_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/wish_destination_prompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/cream_white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/wish_keep_choice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/wish_choice_background"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/wish_keep_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:textColor="@color/deep_navy"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/wish_keep_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:textColor="@color/soft_purple"
                    android:textSize="13sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/wish_send_choice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/wish_choice_background"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/wish_send_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:textColor="@color/deep_navy"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/wish_send_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:textColor="@color/soft_purple"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/wish_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="24dp"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/wish_panel_background"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingExtra="5dp"
            android:padding="20dp"
            android:textColor="@color/deep_navy"
            android:textSize="16sp"
            android:visibility="gone" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/wish_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/gallery_back_background"
        android:contentDescription="@string/wish_back_description"
        android:padding="14dp"
        android:src="@drawable/gallery_back_icon" />

    <FrameLayout
        android:id="@+id/wish_leave_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/wish_leave_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/deep_navy"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="28dp"
            android:background="@drawable/wish_panel_background"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/wish_leave_prompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/deep_navy"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/wish_keep_writing"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/wish_hold_background"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="monospace"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/deep_navy"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wish_leave_now"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/wish_choice_background"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="monospace"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/deep_navy"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
