<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/star_ocean">

    <com.littleblueworld.alia.stars.StarBackdropView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <com.littleblueworld.alia.stars.StarFieldLayout
        android:id="@+id/star_field"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/star_energy"
            android:layout_width="104dp"
            android:layout_height="132dp"
            android:background="@drawable/star_touch_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="8dp">
            <ImageView
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/star" />
            <TextView
                android:id="@+id/star_energy_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:importantForAccessibility="no"
                android:textColor="@color/cream_white"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/star_mind"
            android:layout_width="104dp"
            android:layout_height="132dp"
            android:background="@drawable/star_touch_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="8dp">
            <ImageView
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/star" />
            <TextView
                android:id="@+id/star_mind_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:importantForAccessibility="no"
                android:textColor="@color/cream_white"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/star_face"
            android:layout_width="104dp"
            android:layout_height="132dp"
            android:background="@drawable/star_touch_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="8dp">
            <ImageView
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/star" />
            <TextView
                android:id="@+id/star_face_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:importantForAccessibility="no"
                android:textColor="@color/cream_white"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

    </com.littleblueworld.alia.stars.StarFieldLayout>

    <com.littleblueworld.alia.stars.StarBurstView
        android:id="@+id/star_burst"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <ImageButton
        android:id="@+id/stars_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/gallery_back_background"
        android:contentDescription="@string/star_back_description"
        android:padding="14dp"
        android:src="@drawable/gallery_back_icon" />

    <FrameLayout
        android:id="@+id/star_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/star_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/deep_navy"
            android:clickable="true"
            android:contentDescription="@string/star_close_description"
            android:focusable="true" />

        <LinearLayout
            android:id="@+id/star_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="24dp"
            android:background="@drawable/star_panel_background"
            android:clickable="true"
            android:focusable="true"
            android:importantForAccessibility="no"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="18dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/star_panel_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityLiveRegion="polite"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.06"
                    android:textColor="@color/soft_purple"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <ImageButton
                    android:id="@+id/star_panel_close"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/star_close_description"
                    android:padding="14dp"
                    android:src="@drawable/message_close_icon" />
            </LinearLayout>

            <TextView
                android:id="@+id/star_panel_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:accessibilityLiveRegion="polite"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:lineSpacingExtra="4dp"
                android:minHeight="48dp"
                android:textColor="@color/deep_navy"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/star_completion_cta"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/pixel_primary_button"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="monospace"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingHorizontal="12dp"
                android:textColor="@color/deep_navy"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
