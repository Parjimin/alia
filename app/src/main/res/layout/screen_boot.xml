<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.littleblueworld.alia.boot.BootEffectsView
        android:id="@+id/boot_effects"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/wave_strip"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_gravity="bottom"
        android:alpha="0.38"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/wave_strip" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="32dp">

        <ImageView
            android:id="@+id/loading_star"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@string/boot_loading_star_description"
            android:scaleType="fitCenter"
            android:src="@drawable/loading_star" />

        <TextView
            android:id="@+id/loading_line"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:accessibilityLiveRegion="polite"
            android:fontFamily="monospace"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.02"
            android:maxLines="2"
            android:textColor="@color/cream_white"
            android:textSize="15sp" />
    </LinearLayout>

</FrameLayout>
